{
  "name": "workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 pnpm exec tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 pnpm exec tauri build",
    "tauri": "tauri",
    "gen:types": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 cargo fmt --manifest-path src-tauri/Cargo.toml --check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm gen:types && pnpm lint && pnpm typecheck && pnpm test && pnpm check:rust"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "react-router": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tinykeys": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
