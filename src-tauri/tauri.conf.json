{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench", "version": "0.5.0", "identifier": "com.workbench.app",
  "build": { "beforeDevCommand": "pnpm dev:web", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build:web", "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Workbench", "width": 1320, "height": 860, "minWidth": 980, "minHeight": 640 },
      { "label": "quick", "title": "Workbench", "url": "quick.html", "width": 560, "height": 120, "visible": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false }
    ],
    "security": { "assetProtocol": { "enable": true, "scope": [] }, "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"], "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false } } }
}
